# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버·워커 전용. 클라이언트 번들에 절대 포함 금지

# ── LLM ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5     # 공고 추출·요약 (공고당 1회)
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5   # 영어 지원서 생성

# ── 임베딩 [확인 필요: 공급자 확정] ──────────
EMBEDDING_PROVIDER=gemini           # gemini | openai
EMBEDDING_MODEL=                    # 예: gemini-embedding-001 (출력 차원 1536으로 지정)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── 메일 ──────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=              # Resend 웹훅 서명 검증용
EMAIL_FROM="AI잡5 <hello@example.com>"   # 서비스 도메인으로 교체
EMAIL_LINK_SECRET=                  # 수신거부·피드백 링크 HMAC 서명 키 (32바이트 이상 난수)
EMAIL_TRANSPORT=resend              # resend | file (file이면 실제 발송 없이 .outbox/에 HTML 저장)

# ── 수집 ──────────────────────────────────
SARAMIN_ACCESS_KEY=                 # 선택: 사람인 Open API access-key (oapi.saramin.co.kr, 하루 500회). 없으면 사람인 수집을 건너뜀

# ── 앱 ────────────────────────────────────
APP_URL=http://localhost:3000
ADMIN_EMAILS=                       # 검수 화면 접근 허용, 쉼표로 구분
APPLY_FREE_MONTHLY_LIMIT=3          # 제안값
DIGEST_SIZE=3
