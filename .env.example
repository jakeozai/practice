# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버·워커 전용. 클라이언트 번들에 절대 포함 금지

# ── LLM (공고 추출·요약, 공고당 1회) ─────────
# Vercel에서는 AI Gateway를 OIDC로 쓰므로 키가 필요 없어요. 모델 ID는 게이트웨이 형식.
ANTHROPIC_MODEL_FAST=google/gemini-2.5-flash-lite   # 2026-11-12: Gateway free tier can't use Anthropic models; anthropic/claude-haiku-5.5 after a credit top-up
# 로컬에서 게이트웨이를 쓰려면 AI_GATEWAY_API_KEY, Anthropic을 직접 쓰려면 ANTHROPIC_API_KEY
# (이때 모델 ID는 Anthropic 형식, 예: claude-haiku-5-5)
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=

# ── 임베딩 (Phase 2, 2026-11-09 결정: OpenAI) ──
EMBEDDING_MODEL=openai/text-embedding-3-small   # 1536차원, AI Gateway 경유

# ── 메일 ──────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=              # Resend 웹훅 서명 검증용 (whsec_…)
EMAIL_FROM="덕잡 <onboarding@resend.dev>"   # 발신 도메인 인증 전엔 Resend 테스트 주소(계정 주인에게만 발송)
EMAIL_LINK_SECRET=                  # 로그인 요청 제한·수신거부 링크 HMAC 키 (32바이트 이상 난수)
EMAIL_TRANSPORT=resend              # resend | file (file이면 실제 발송 없이 .outbox/에 HTML 저장)
CONTACT_EMAIL=                      # 처리방침·메일 하단 문의 주소. 비우면 "준비 중"으로 표시

# ── 앱 ────────────────────────────────────
APP_URL=http://localhost:3000
ADMIN_EMAILS=                       # 검수 화면 접근 허용, 쉼표로 구분
DIGEST_SIZE=3
CRON_SECRET=                        # Vercel Cron이 /api/cron/*을 부를 때 쓰는 비밀값 (16자 이상)
